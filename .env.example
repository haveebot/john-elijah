# ── Database (Neon via Vercel Storage: john-elijah-db) ──────────────
DATABASE_URL=

# ── Auth ────────────────────────────────────────────────────────────
# openssl rand -hex 32
AUTH_HMAC_SECRET=
# Per-person HQ access codes (Palm Republic pattern): "CODE:Name:role,…" roles owner|artist
HQ_CODES="WC!:Winston:owner,JE!:John:artist"

# ── Assets (Vercel Blob: john-elijah-assets) ────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Stripe (merch checkout) — absent = no-keys mode (notify-me buttons)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Shippo (labels from HQ Orders) — absent = "connect Shippo" state ─
SHIPPO_API_KEY=
# Ship-from address as a Shippo address object (one line of JSON)
SHIP_FROM_JSON=

# ── Mail — absent = no-op sends ─────────────────────────────────────
# Preferred: Google Workspace SMTP (admin@ mailbox + app password; booking@ is an alias)
SMTP_USER=admin@johnelijahmusic.com
SMTP_PASS=
# Fallback: Resend with a verified domain
RESEND_API_KEY=
MAIL_FROM="John Elijah Band <booking@johnelijahmusic.com>"
BOOKING_NOTIFY_EMAIL=admin@johnelijahmusic.com

# ── AI drafting (HQ voice tools; optional) ─────────────────────────
ANTHROPIC_API_KEY=
